{
  "name": "msomi-hub-backend",
  "version": "2.0.0",
  "description": "Backend API for Msomi Hub - payments, admin, past-paper storage, and reminders only. Everything else runs on Supabase.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reminders:check": "node src/scripts/runReminderCheck.js",
    "setup:storage": "node scripts/setupStorage.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.18.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# --- Supabase Postgres connection (pooler, "Transaction" mode) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Supabase project API (for Storage signed URLs / uploads) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-expose-to-frontend

# --- Supabase JWT secret (to verify tokens issued by Supabase Auth) ---
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-project-jwt-secret

# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# --- PayHero (M-Pesa STK Push) ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://your-api-host.example.com/api/payments/callback
PAYHERO_COFFEE_CALLBACK_URL=https://your-api-host.example.com/api/coffee/callback

# Subscription price (KES) and validity period
SUBSCRIPTION_PRICE=100
SUBSCRIPTION_VALIDITY_DAYS=365

# Site-wide free access toggle (bypasses the paywall for everyone) - leave false in production
FREE_MODE=false

# --- Class & CAT/exam reminders ---
# Leave unset/false in production - see backend/README-cron.md for how the
# reminder check actually gets triggered on a schedule.
ENABLE_INTERNAL_SCHEDULER=false

# Leave AT_USERNAME/AT_API_KEY blank to disable SMS (email keeps working).
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Leave SMTP_* blank to disable email (SMS keeps working).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Msomi Hub <you@example.com>

# Long random string - protects /api/cron/check-reminders from public abuse
CRON_SECRET=
